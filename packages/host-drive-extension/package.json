{
  "name": "@electron-jupyter-sandbox/host-drive-extension",
  "version": "1.0.0",
  "description": "Host OS direct file system drive extension for JupyterLab in Electron sandbox",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*.{d.ts,eot,gif,html,jpg,js,js.map,json,png,svg,woff2,ttf}"
  ],
  "scripts": {
    "build": "tsc && uv run jupyter labextension build .",
    "clean": "rimraf lib labextension tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@jupyterlab/application": "^4.0.0",
    "@jupyterlab/coreutils": "^6.0.0",
    "@jupyterlab/docmanager": "^4.0.0",
    "@jupyterlab/filebrowser": "^4.0.0",
    "@jupyterlab/services": "^7.0.0",
    "@lumino/coreutils": "^2.0.0",
    "@lumino/disposable": "^2.0.0",
    "@lumino/signaling": "^2.0.0"
  },
  "devDependencies": {
    "@jupyter/builder": "^1.2.3",
    "rimraf": "^5.0.5",
    "typescript": "~5.3.0"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "labextension"
  }
}
