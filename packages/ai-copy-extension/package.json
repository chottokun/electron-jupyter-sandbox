{
  "name": "@electron-jupyter-sandbox/ai-copy-extension",
  "version": "1.0.0",
  "description": "AI-friendly error copy extension for JupyterLab in Electron sandbox",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*.{d.ts,eot,gif,html,jpg,js,js.map,json,png,svg,woff2,ttf}"
  ],
  "scripts": {
    "build": "tsc",
    "build:labextension": "jupyter labextension build .",
    "clean": "rimraf lib tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@jupyterlab/application": "^4.0.0",
    "@jupyterlab/cells": "^4.0.0",
    "@jupyterlab/notebook": "^4.0.0",
    "@jupyterlab/rendermime": "^4.0.0"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^4.0.0",
    "rimraf": "^5.0.5",
    "typescript": "~5.3.0"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "../../jupyterlite/extensions/@electron-jupyter-sandbox/ai-copy-extension"
  }
}
