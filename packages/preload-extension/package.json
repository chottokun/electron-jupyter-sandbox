{
  "name": "@electron-jupyter-sandbox/preload-extension",
  "version": "1.0.0",
  "description": "Kernel auto preload extension for JupyterLite in Electron sandbox",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*.{d.ts,eot,gif,html,jpg,js,js.map,json,png,svg,woff2,ttf}"
  ],
  "scripts": {
    "build": "tsc && uv run jupyter labextension build .",
    "clean": "rimraf lib labextension tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@jupyterlab/application": "^4.0.0",
    "@jupyterlab/coreutils": "^6.0.0",
    "@jupyterlab/notebook": "^4.0.0"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^4.0.0",
    "rimraf": "^5.0.5",
    "typescript": "~5.3.0"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "labextension"
  }
}
