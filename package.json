{
  "name": "electron-jupyter-sandbox",
  "version": "1.1.1",
  "description": "完全隔離型・AI連携デスクトップJupyter環境",
  "license": "MIT",
  "main": "src/main.js",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test tests/**/*.test.js",
    "build:ext": "npm run --workspace=@electron-jupyter-sandbox/ai-copy-extension build",
    "build:jupyter": "uv run jupyter lite build --config jupyter_lite_config.json",
    "build": "npm run build:ext && npm run build:jupyter",
    "start": "electron . --no-sandbox",
    "start:configurable": "ALLOW_NETWORK_CONFIG=true electron . --no-sandbox",
    "package:win": "electron-builder --win --x64 --publish never",
    "package:win:configurable": "ALLOW_NETWORK_CONFIG=true electron-builder --win --x64 --publish never",
    "package:mac": "electron-builder --mac --publish never",
    "package:linux": "electron-builder --linux AppImage --publish never"
  },

  "build": {
    "appId": "com.example.electron-jupyter-sandbox",
    "productName": "JupyterSandbox",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "jupyterlite/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable",
        "zip"
      ]
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": false
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg"
      ]
    }
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "tar": "7.5.22",
    "sanitize-html": "2.17.7"
  },
  "volta": {
    "node": "22.14.0",
    "npm": "10.9.2"
  }
}
